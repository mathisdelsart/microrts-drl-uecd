% IEEE bibliography for the CoG 2026 paper, formatted to the official IEEEtran
% conventions (see IEEEtranBST2/IEEEexample.bib and IEEEtran_bst_HOWTO.pdf):
%   - Field values in "..." quotes; proper nouns / acronyms brace-protected ({AI}, {StarCraft II}).
%   - Journal/conference names IEEE-abbreviated; "Proc. {IEEE} ..." for proceedings.
%   - Full {IEEEtranBSTCTL} control entry (activate once with \bstctlcite{BSTcontrol}).
%   - The 3 uncited entries (alpha-Rank, Copeland, Savage) are intentionally omitted.
%
% Author display is governed entirely by the control entry below (NOT by the entries):
%   CTLuse_forced_etal = "yes" + CTLmax_names_forced_etal = "5" + CTLnames_show_etal = "1"
%   => 1-5 authors are listed in full; 6 or more collapse to "First Author et al."
%   This follows the IEEE conference template ("Unless there are six authors or
%   more give all authors' names; do not use et al."). Set CTLuse_forced_etal = "no"
%   to list every author instead (the IEEEexample.bib default).

@IEEEtranBSTCTL{BSTcontrol,
  CTLuse_article_number     = "yes",
  CTLuse_paper              = "yes",
  CTLuse_forced_etal        = "yes",
  CTLmax_names_forced_etal  = "5",
  CTLnames_show_etal        = "1",
  CTLuse_alt_spacing        = "yes",
  CTLalt_stretch_factor     = "4",
  CTLdash_repeated_names    = "yes",
  CTLname_format_string     = "{f.~}{vv~}{ll}{, jj}",
  CTLname_latex_cmd         = "",
  CTLname_url_prefix        = "[Online]. Available:"
}

