# OS files
.DS_Store
Thumbs.db

# Editors / IDEs / local context
.vscode/
.idea/
.claude/
*.swp
*.swo

# Secrets / local env
.env

# Build outputs
bin/
build/
dist/
out/
*.class
*.whl
*.zip
.java-build/

# Python caches / runtime
__pycache__/
*.pyc
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Python virtual environments
.venv/
venv/
cluster_venv/
uts_imass_env/

# Competition-bot build deploy directory (microrts_agent/bots/build_all.sh output)
microrts_agent/bots/jars/

# Logs
*.log

# Run outputs (training, eval, tournaments, BC dumps) + experiment tracking
outputs/
*.tfevents.*
wandb/

# Model checkpoints, dataset chunks, recordings
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.mp4

# Everything under data/ is curated and shipped.
# Refactor-proof: no per-extension or per-subdir override list to keep in sync.
!data/**

# Defensive re-ignore for OS / editor / Python junk that may accidentally
# leak into data/ (e.g. Finder creating .DS_Store while browsing recordings).
data/**/.DS_Store
data/**/Thumbs.db
data/**/*.swp
data/**/*.swo
data/**/__pycache__/
data/**/*.pyc

