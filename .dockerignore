# Trim the Docker build context. Mostly mirrors .gitignore, with additional
# exclusions for heavy academic-side data that the runtime image doesn't need.

# Git metadata + GitHub config
.git/
.github/

# Editors / IDEs / local context
.vscode/
.idea/
.claude/

# OS junk
.DS_Store
Thumbs.db

# Editor swap files
*.swp
*.swo

# Secrets / local env
.env

# Build outputs (gitignored, defensive)
bin/
build/
dist/
out/
*.class
*.whl
*.zip
.java-build/

# Python caches / runtime
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Python virtual environments
.venv/
venv/
cluster_venv/
uts_imass_env/

# Test / coverage
.coverage
htmlcov/

# Run outputs (training, eval, tournaments, BC dumps) + experiment tracking
outputs/
*.tfevents.*
wandb/

# Thesis-side material (LaTeX source, PDFs)
dissertation/
cog-2026-paper/

# Heavy research data not needed at image build time. The image only keeps
# data/agents/ (the 9 shipped trained agents, the typical eval target). All
# other data/ subtrees are academic-side material that would add hundreds of
# MB to the image without helping the typical user. To use them at runtime,
# mount them as a volume (see the Dockerfile header for `docker run -v ...`
# examples).
data/recordings/
data/tournaments/
data/rush_collapse/
data/generalization_probes/
data/ablation/
data/BC/
